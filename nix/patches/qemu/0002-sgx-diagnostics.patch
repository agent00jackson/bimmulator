diff --git a/hw/display/omap5430_sgx_usse.h b/hw/display/omap5430_sgx_usse.h
new file mode 100644
index 000000000..bb41840e6
--- /dev/null
+++ b/hw/display/omap5430_sgx_usse.h
@@ -0,0 +1,416 @@
+#ifndef OMAP5430_SGX_USSE_H
+#define OMAP5430_SGX_USSE_H
+
+/*
+ * Small, pure USSE prefix decoder shared by the QEMU device and the offline
+ * firmware-fixture replay. Field layouts follow the pinned SGX543 grammar;
+ * they are candidates for the BMW SGX544-class firmware, not a silicon spec.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+
+#define SGX_USSE_TEMP_COUNT 128
+
+typedef struct SGXUSSELimmFields {
+    uint32_t predicate;
+    uint32_t bank_ext;
+    uint32_t bank;
+    uint32_t destination;
+    uint32_t immediate;
+} SGXUSSELimmFields;
+
+typedef struct SGXUSSEVldstFields {
+    uint32_t op1;
+    uint32_t predicate;
+    uint32_t skip_invalid;
+    uint32_t no_schedule;
+    uint32_t moe_expand;
+    uint32_t sync_start;
+    uint32_t cache_ext;
+    uint32_t src0_bank_ext;
+    uint32_t src1_bank_ext;
+    uint32_t src2_bank_ext;
+    uint32_t mask_count;
+    uint32_t mode;
+    uint32_t address_mode;
+    uint32_t dest_bank_primattr;
+    uint32_t range_enable;
+    uint32_t data_type;
+    uint32_t increment_or_decrement;
+    uint32_t src0_bank;
+    uint32_t cache_by_pass12;
+    uint32_t drc_sel;
+    uint32_t src1_bank;
+    uint32_t src2_bank;
+    uint32_t destination;
+    uint32_t src0_n;
+    uint32_t src1_n;
+    uint32_t src2_n;
+} SGXUSSEVldstFields;
+
+typedef struct SGXUSSEVldstPrimaryLoadCandidate {
+    uint32_t address;
+    uint32_t destination;
+    uint32_t byte_width;
+} SGXUSSEVldstPrimaryLoadCandidate;
+
+typedef struct SGXUSSEVBWFields {
+    uint32_t op1;
+    uint32_t predicate;
+    uint32_t skip_invalid;
+    uint32_t no_schedule;
+    uint32_t repeat_select;
+    uint32_t sync_start;
+    uint32_t destination_ext;
+    uint32_t end;
+    uint32_t src1_ext;
+    uint32_t src2_ext;
+    uint32_t repeat_count;
+    uint32_t src2_invert;
+    uint32_t src2_rotate;
+    uint32_t src2_ext_high;
+    uint32_t op2;
+    uint32_t partial_16bit;
+    uint32_t destination_bank;
+    uint32_t src1_bank;
+    uint32_t src2_bank;
+    uint32_t destination;
+    uint32_t src2_select;
+    uint32_t src1;
+    uint32_t src2;
+} SGXUSSEVBWFields;
+
+typedef enum SGXUSSEVBWOperationCandidate {
+    SGX_USSE_VBW_AND_CANDIDATE,
+    SGX_USSE_VBW_OR_CANDIDATE,
+    SGX_USSE_VBW_XOR_CANDIDATE,
+    SGX_USSE_VBW_SHL_CANDIDATE,
+    SGX_USSE_VBW_ROL_CANDIDATE,
+    SGX_USSE_VBW_SHR_CANDIDATE,
+    SGX_USSE_VBW_ASR_CANDIDATE,
+} SGXUSSEVBWOperationCandidate;
+
+typedef struct SGXUSSEVBWDecodedCandidate {
+    SGXUSSEVBWOperationCandidate operation;
+    uint32_t byte_width;
+} SGXUSSEVBWDecodedCandidate;
+
+/* Public SGX544 table fields; decode only, with no output/task effects. */
+typedef struct SGXUSSEEmitFields {
+    uint32_t sideband_high;
+    uint32_t opcat;
+    uint32_t src0_bank_ext;
+    uint32_t end;
+    uint32_t src1_bank_ext;
+    uint32_t src2_bank_ext;
+    uint32_t target;
+    uint32_t task_start_or_mte_hi;
+    uint32_t task_end_or_mte_lo;
+    uint32_t no_schedule;
+    uint32_t sideband_mid;
+    uint32_t src0_bank;
+    uint32_t incp;
+    uint32_t src1_bank;
+    uint32_t src2_bank;
+    uint32_t sideband_low;
+    uint32_t freep;
+    uint32_t src0;
+    uint32_t src1;
+    uint32_t src2;
+} SGXUSSEEmitFields;
+
+typedef struct SGXUSSEBranchFields {
+    uint32_t predicate;
+    uint32_t save_link;
+    uint32_t branch_type;
+    uint32_t any_instruction;
+    uint32_t all_instructions;
+    uint32_t offset20;
+} SGXUSSEBranchFields;
+
+typedef enum SGXUSSEPrefixResult {
+    SGX_USSE_PREFIX_NOT_HANDLED,
+    SGX_USSE_PREFIX_APPLIED_LIMM,
+    SGX_USSE_PREFIX_ADVANCED_NOP,
+    SGX_USSE_PREFIX_STOP_UNSUPPORTED_LIMM,
+    SGX_USSE_PREFIX_STOP_UNRESOLVED_VLDST,
+    SGX_USSE_PREFIX_STOP_UNRESOLVED_BRANCH,
+} SGXUSSEPrefixResult;
+
+typedef struct SGXUSSEPrefixFields {
+    SGXUSSELimmFields limm;
+    SGXUSSEVldstFields vldst;
+    SGXUSSEBranchFields branch;
+} SGXUSSEPrefixFields;
+
+static inline bool sgx_usse_decode_limm(uint64_t instruction,
+                                        SGXUSSELimmFields *fields)
+{
+    const uint64_t mask = UINT64_C(0xff30000000000000);
+    const uint64_t pattern = UINT64_C(0xfc20000000000000);
+
+    if ((instruction & mask) != pattern) {
+        return false;
+    }
+
+    fields->predicate = (instruction >> 41) & 7;
+    fields->bank_ext = (instruction >> 51) & 1;
+    fields->bank = (instruction >> 32) & 3;
+    fields->destination = (instruction >> 21) & 0x7f;
+    fields->immediate = (instruction & 0x1fffff) |
+                        (((instruction >> 36) & 0x1f) << 21) |
+                        (((instruction >> 44) & 0x3f) << 26);
+    return true;
+}
+
+static inline bool sgx_usse_is_nop(uint64_t instruction)
+{
+    return (instruction >> 59) == 0x1f &&
+           ((instruction >> 54) & 1) == 0 &&
+           ((instruction >> 52) & 3) == 0 &&
+           ((instruction >> 38) & 7) == 5;
+}
+
+static inline bool sgx_usse_decode_vldst(uint64_t instruction,
+                                         SGXUSSEVldstFields *fields)
+{
+    uint32_t op1;
+
+    if ((instruction >> 61) != 7) {
+        return false;
+    }
+    op1 = (instruction >> 59) & 3;
+    if (op1 != 1 && op1 != 2) {
+        return false;
+    }
+
+    fields->op1 = op1;
+    fields->predicate = (instruction >> 56) & 7;
+    fields->skip_invalid = (instruction >> 55) & 1;
+    fields->no_schedule = (instruction >> 54) & 1;
+    fields->moe_expand = (instruction >> 53) & 1;
+    fields->sync_start = (instruction >> 52) & 1;
+    fields->cache_ext = (instruction >> 51) & 1;
+    fields->src0_bank_ext = (instruction >> 50) & 1;
+    fields->src1_bank_ext = (instruction >> 49) & 1;
+    fields->src2_bank_ext = (instruction >> 48) & 1;
+    fields->mask_count = (instruction >> 44) & 0xf;
+    fields->mode = (instruction >> 40) & 3;
+    fields->address_mode = (instruction >> 42) & 3;
+    fields->dest_bank_primattr = (instruction >> 39) & 1;
+    fields->range_enable = (instruction >> 38) & 1;
+    fields->data_type = (instruction >> 36) & 3;
+    fields->increment_or_decrement = (instruction >> 35) & 1;
+    fields->src0_bank = (instruction >> 34) & 1;
+    fields->cache_by_pass12 = (instruction >> 33) & 1;
+    fields->drc_sel = (instruction >> 32) & 1;
+    fields->src1_bank = (instruction >> 30) & 3;
+    fields->src2_bank = (instruction >> 28) & 3;
+    fields->destination = (instruction >> 21) & 0x7f;
+    fields->src0_n = (instruction >> 14) & 0x7f;
+    fields->src1_n = (instruction >> 7) & 0x7f;
+    fields->src2_n = instruction & 0x7f;
+    return true;
+}
+
+/* Decode only the SGX543 grammar fields for a VBW instruction. */
+static inline bool sgx_usse_decode_vbw(uint64_t instruction,
+                                       SGXUSSEVBWFields *fields)
+{
+    if (((instruction >> 62) & 3) != 1) {
+        return false;
+    }
+
+    fields->op1 = (instruction >> 59) & 7;
+    fields->predicate = (instruction >> 56) & 7;
+    fields->skip_invalid = (instruction >> 55) & 1;
+    fields->no_schedule = (instruction >> 54) & 1;
+    fields->repeat_select = (instruction >> 53) & 1;
+    fields->sync_start = (instruction >> 52) & 1;
+    fields->destination_ext = (instruction >> 51) & 1;
+    fields->end = (instruction >> 50) & 1;
+    fields->src1_ext = (instruction >> 49) & 1;
+    fields->src2_ext = (instruction >> 48) & 1;
+    fields->repeat_count = (instruction >> 44) & 0xf;
+    fields->src2_invert = (instruction >> 43) & 1;
+    fields->src2_rotate = (instruction >> 38) & 0x1f;
+    fields->src2_ext_high = (instruction >> 36) & 3;
+    fields->op2 = (instruction >> 35) & 1;
+    fields->partial_16bit = (instruction >> 34) & 1;
+    fields->destination_bank = (instruction >> 32) & 3;
+    fields->src1_bank = (instruction >> 30) & 3;
+    fields->src2_bank = (instruction >> 28) & 3;
+    fields->destination = (instruction >> 21) & 0x7f;
+    fields->src2_select = (instruction >> 14) & 0x7f;
+    fields->src1 = (instruction >> 7) & 0x7f;
+    fields->src2 = instruction & 0x7f;
+    return true;
+}
+
+/* Decode the published SGX544 EMIT layout; do not execute it. */
+static inline bool sgx_usse_decode_emit(uint64_t instruction,
+                                        SGXUSSEEmitFields *fields)
+{
+    if ((instruction >> 59) != 0x1f ||
+        ((instruction >> 56) & 7) != 3 ||
+        ((instruction >> 52) & 3) != 2) {
+        return false;
+    }
+
+    fields->sideband_high = (instruction >> 54) & 3;
+    fields->opcat = (instruction >> 52) & 3;
+    fields->src0_bank_ext = (instruction >> 51) & 1;
+    fields->end = (instruction >> 50) & 1;
+    fields->src1_bank_ext = (instruction >> 49) & 1;
+    fields->src2_bank_ext = (instruction >> 48) & 1;
+    fields->target = (instruction >> 46) & 3;
+    fields->task_start_or_mte_hi = (instruction >> 45) & 1;
+    fields->task_end_or_mte_lo = (instruction >> 44) & 1;
+    fields->no_schedule = (instruction >> 43) & 1;
+    fields->sideband_mid = (instruction >> 35) & 0x3f;
+    fields->src0_bank = (instruction >> 34) & 1;
+    fields->incp = (instruction >> 32) & 3;
+    fields->src1_bank = (instruction >> 30) & 3;
+    fields->src2_bank = (instruction >> 28) & 3;
+    fields->sideband_low = (instruction >> 22) & 0x3f;
+    fields->freep = (instruction >> 21) & 1;
+    fields->src0 = (instruction >> 14) & 0x7f;
+    fields->src1 = (instruction >> 7) & 0x7f;
+    fields->src2 = instruction & 0x7f;
+    return true;
+}
+
+/*
+ * Classify the opcode using Vita3K's SGX543 translator as a reference.
+ * This reports no operand-bank or register effects and does not execute.
+ */
+static inline bool sgx_usse_vbw_operation_candidate(
+    const SGXUSSEVBWFields *fields, SGXUSSEVBWDecodedCandidate *candidate)
+{
+    switch (fields->op1) {
+    case 2:
+        candidate->operation = fields->op2 ? SGX_USSE_VBW_OR_CANDIDATE :
+                                              SGX_USSE_VBW_AND_CANDIDATE;
+        break;
+    case 3:
+        candidate->operation = SGX_USSE_VBW_XOR_CANDIDATE;
+        break;
+    case 4:
+        candidate->operation = fields->op2 ? SGX_USSE_VBW_ROL_CANDIDATE :
+                                              SGX_USSE_VBW_SHL_CANDIDATE;
+        break;
+    case 5:
+        candidate->operation = fields->op2 ? SGX_USSE_VBW_ASR_CANDIDATE :
+                                              SGX_USSE_VBW_SHR_CANDIDATE;
+        break;
+    default:
+        return false;
+    }
+
+    candidate->byte_width = fields->partial_16bit ? 2 : 4;
+    return true;
+}
+
+/*
+ * Candidate semantics for the captured scalar LDR form. Imagination's
+ * support forum states that SGX543 and SGX544 share the instruction set for
+ * debugging/profiling; this address calculation follows Vita3K's SGX543
+ * translator. It is intentionally limited to the exact simple register and
+ * immediate form below. The caller must separately assume a primary program
+ * and must not treat this as silicon-validated execution.
+ */
+static inline bool sgx_usse_vldst_primary_load_candidate(
+    const SGXUSSEVldstFields *fields,
+    const uint32_t temp[SGX_USSE_TEMP_COUNT],
+    const bool temp_valid[SGX_USSE_TEMP_COUNT],
+    SGXUSSEVldstPrimaryLoadCandidate *candidate)
+{
+    uint64_t address;
+
+    if (fields->op1 != 1 || fields->predicate != 0 ||
+        fields->skip_invalid != 0 || fields->no_schedule != 0 ||
+        fields->sync_start != 0 || fields->cache_ext != 0 ||
+        fields->mask_count != 0 || fields->mode != 0 ||
+        fields->address_mode != 0 || fields->dest_bank_primattr != 0 ||
+        fields->range_enable != 0 || fields->data_type != 0 ||
+        fields->increment_or_decrement != 0 || fields->src0_bank_ext != 0 ||
+        fields->src0_bank != 0 || fields->src0_n >= SGX_USSE_TEMP_COUNT ||
+        fields->src1_bank_ext != 1 || fields->src1_bank != 2 ||
+        fields->src2_bank_ext != 1 || fields->src2_bank != 2 ||
+        fields->destination >= SGX_USSE_TEMP_COUNT ||
+        fields->cache_by_pass12 != 1 || fields->drc_sel != 0 ||
+        !temp_valid[fields->src0_n]) {
+        return false;
+    }
+
+    /* Extended source-bank selector 2 is IMMEDIATE in the SGX543 decoder.
+     * The translator scales src1 by the f32 width, adds src2 as bytes, and
+     * adds four bytes only when moe_expand is clear. */
+    address = temp[fields->src0_n] + (uint64_t)fields->src1_n * 4 +
+              fields->src2_n + (fields->moe_expand ? 0 : 4);
+    if (address > UINT32_MAX) {
+        return false;
+    }
+
+    candidate->address = (uint32_t)address;
+    candidate->destination = fields->destination;
+    candidate->byte_width = 4;
+    return true;
+}
+
+static inline bool sgx_usse_decode_branch_fields(
+    uint64_t instruction, SGXUSSEBranchFields *fields)
+{
+    uint32_t word1 = instruction >> 32;
+
+    /* Match only the fixed SGX543 BR opcode fields; semantics remain open. */
+    if ((word1 >> 27) != 0x1f ||
+        ((instruction >> 54) & 1) != 0 ||
+        ((instruction >> 52) & 3) != 0 ||
+        ((instruction >> 39) & 3) != 0) {
+        return false;
+    }
+
+    fields->predicate = (instruction >> 56) & 7;
+    fields->save_link = (instruction >> 41) & 1;
+    fields->branch_type = (instruction >> 38) & 1;
+    fields->any_instruction = (instruction >> 21) & 1;
+    fields->all_instructions = (instruction >> 20) & 1;
+    fields->offset20 = instruction & 0xfffff;
+    return true;
+}
+
+/*
+ * Apply only the entry-prefix effects currently supported by both callers.
+ * VLDST and BR are decoded for diagnostics but stop before any state change.
+ */
+static inline SGXUSSEPrefixResult sgx_usse_step_prefix(
+    uint64_t instruction, uint32_t temp[SGX_USSE_TEMP_COUNT],
+    bool temp_valid[SGX_USSE_TEMP_COUNT], SGXUSSEPrefixFields *fields)
+{
+    if (sgx_usse_decode_limm(instruction, &fields->limm)) {
+        if (fields->limm.predicate != 0 || fields->limm.bank_ext != 0 ||
+            fields->limm.bank != 0 || fields->limm.destination >= 124) {
+            return SGX_USSE_PREFIX_STOP_UNSUPPORTED_LIMM;
+        }
+        temp[fields->limm.destination] = fields->limm.immediate;
+        temp_valid[fields->limm.destination] = true;
+        return SGX_USSE_PREFIX_APPLIED_LIMM;
+    }
+
+    if (sgx_usse_is_nop(instruction)) {
+        return SGX_USSE_PREFIX_ADVANCED_NOP;
+    }
+
+    if (sgx_usse_decode_vldst(instruction, &fields->vldst)) {
+        return SGX_USSE_PREFIX_STOP_UNRESOLVED_VLDST;
+    }
+
+    if (sgx_usse_decode_branch_fields(instruction, &fields->branch)) {
+        return SGX_USSE_PREFIX_STOP_UNRESOLVED_BRANCH;
+    }
+
+    return SGX_USSE_PREFIX_NOT_HANDLED;
+}
+
+#endif
