diff --git a/hw/arm/omap5430.c b/hw/arm/omap5430.c
new file mode 100644
index 000000000..1f91d2a72
--- /dev/null
+++ b/hw/arm/omap5430.c
@@ -0,0 +1,229 @@
+/*
+ * Minimal OMAP5430 machine model for the BMW NBTevo QNX software stack.
+ *
+ * This model provides the dual Cortex-A15 cluster, OMAP5-addressed GIC-400
+ * and UART blocks, and generic EHCI/xHCI hosts used by the QNX image. Other
+ * OMAP5 peripherals are added as their guest-driver requirements are reverse
+ * engineered.
+ *
+ * Copyright (c) 2026
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qapi/error.h"
+#include "hw/arm/boot.h"
+#include "hw/arm/machines-qom.h"
+#include "hw/char/serial-mm.h"
+#include "hw/core/boards.h"
+#include "hw/core/cpu.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "hw/dma/omap5430_sdma.h"
+#include "hw/display/omap5430_sgx.h"
+#include "hw/display/omap5430_dss.h"
+#include "monitor/qdev.h"
+#include "hw/cpu/a15mpcore.h"
+#include "hw/usb/hcd-ehci.h"
+#include "hw/usb/hcd-ohci.h"
+#include "hw/usb/xhci.h"
+#include "hw/usb/usb.h"
+#include "hw/misc/unimp.h"
+#include "net/net.h"
+#include "system/address-spaces.h"
+#include "system/system.h"
+#include "target/arm/cpu.h"
+#include "target/arm/cpu-qom.h"
+
+#define OMAP5430_GIC_BASE       0x48210000
+#define OMAP5430_GIC_IRQS       256
+#define OMAP5430_RAM_BASE       0x80000000
+#define OMAP5430_SDMA_BASE      0x4a056000
+#define OMAP5430_SDMA_SPI       12
+#define OMAP5430_OHCI_BASE      0x4a064800
+#define OMAP5430_OHCI_SPI       76
+#define OMAP5430_EHCI_BASE      0x4a064c00
+#define OMAP5430_EHCI_SPI       77
+#define OMAP5430_XHCI_BASE      0x4a030000
+#define OMAP5430_XHCI_SPI       92
+#define TYPE_USB_NET            "usb-net"
+
+/* OMAP5 UART register blocks and GIC SPI numbers from TI's OMAP5 device tree. */
+static const hwaddr omap5430_uart_base[] = {
+    0x4806a000, /* UART1 */
+    0x4806c000, /* UART2 */
+    0x48020000, /* UART3: BMW boot console */
+    0x4806e000, /* UART4 */
+    0x48066000, /* UART5 */
+    0x48068000, /* UART6 */
+};
+
+static const unsigned int omap5430_uart_spi[] = {
+    72, 73, 74, 70, 105, 106,
+};
+
+static void omap5430_init_cpus(MachineState *machine, qemu_irq *pic)
+{
+    DeviceState *dev;
+    SysBusDevice *busdev;
+    unsigned int n;
+
+    for (n = 0; n < machine->smp.cpus; n++) {
+        Object *cpuobj = object_new(machine->cpu_type);
+
+        object_property_set_bool(cpuobj, "has_el3", false, &error_fatal);
+        if (object_property_find(cpuobj, "has_el2")) {
+            object_property_set_bool(cpuobj, "has_el2", false, &error_fatal);
+        }
+        if (object_property_find(cpuobj, "reset-cbar")) {
+            object_property_set_int(cpuobj, "reset-cbar", OMAP5430_GIC_BASE,
+                                    &error_fatal);
+        }
+        /* BMW startup calibrates ClockCycles and timer reloads at 6.144 MHz.
+         * A15's default 62.5 MHz causes about ten timer interrupts per tick.
+         */
+        object_property_set_int(cpuobj, "cntfrq", 6144000, &error_fatal);
+        qdev_realize(DEVICE(cpuobj), NULL, &error_fatal);
+    }
+
+    dev = qdev_new(TYPE_A15MPCORE_PRIV);
+    qdev_prop_set_uint32(dev, "num-cpu", machine->smp.cpus);
+    qdev_prop_set_uint32(dev, "num-irq", OMAP5430_GIC_IRQS);
+    busdev = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(busdev, &error_fatal);
+    sysbus_mmio_map(busdev, 0, OMAP5430_GIC_BASE);
+
+    for (n = 0; n < OMAP5430_GIC_IRQS - 32; n++) {
+        pic[n] = qdev_get_gpio_in(dev, n);
+    }
+
+    for (n = 0; n < machine->smp.cpus; n++) {
+        DeviceState *cpudev = DEVICE(qemu_get_cpu(n));
+
+        sysbus_connect_irq(busdev, n, qdev_get_gpio_in(cpudev, ARM_CPU_IRQ));
+        sysbus_connect_irq(busdev, n + machine->smp.cpus,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_FIQ));
+        sysbus_connect_irq(busdev, n + 2 * machine->smp.cpus,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_VIRQ));
+        sysbus_connect_irq(busdev, n + 3 * machine->smp.cpus,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_VFIQ));
+    }
+}
+
+static void omap5430_init_usb(qemu_irq *pic)
+{
+    DeviceState *ehci;
+    DeviceState *ohci;
+    DeviceState *xhci;
+    DeviceState *nic;
+
+    ehci = qdev_new(TYPE_PLATFORM_EHCI);
+    object_property_set_bool(OBJECT(ehci), "companion-enable", true,
+                             &error_fatal);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(ehci), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(ehci), 0, OMAP5430_EHCI_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(ehci), 0, pic[OMAP5430_EHCI_SPI]);
+
+    /* OMAP5 routes low/full-speed peripherals through the OHCI companion. */
+    ohci = qdev_new(TYPE_SYSBUS_OHCI);
+    object_property_set_str(OBJECT(ohci), "masterbus",
+                            SYS_BUS_EHCI(ehci)->ehci.bus.qbus.name,
+                            &error_fatal);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(ohci), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(ohci), 0, OMAP5430_OHCI_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(ohci), 0, pic[OMAP5430_OHCI_SPI]);
+
+    /* The BMW manifest configures the DWC3 xHCI core at this OMAP5 window. */
+    xhci = qdev_new(TYPE_XHCI_SYSBUS);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(xhci), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(xhci), 0, OMAP5430_XHCI_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(xhci), 0, pic[OMAP5430_XHCI_SPI]);
+
+    /* -nic user,model=usb-net attaches CDC/RNDIS Ethernet to OMAP EHCI. */
+    while ((nic = qemu_create_nic_device(TYPE_USB_NET, true, NULL))) {
+        qdev_realize_and_unref(nic, &SYS_BUS_EHCI(ehci)->ehci.bus.qbus,
+                               &error_fatal);
+    }
+}
+
+static void omap5430_init(MachineState *machine)
+{
+    MemoryRegion *sysmem = get_system_memory();
+    qemu_irq pic[OMAP5430_GIC_IRQS - 32] = { 0 };
+    DeviceState *dss;
+    DeviceState *sdma;
+    unsigned int i;
+
+    memory_region_add_subregion(sysmem, OMAP5430_RAM_BASE, machine->ram);
+    dss = qdev_new(TYPE_OMAP5430_DSS);
+    qdev_set_id(dss, g_strdup("omap5-dss"), &error_fatal);
+    object_property_set_link(OBJECT(dss), "system-memory", OBJECT(sysmem),
+                             &error_fatal);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dss), &error_fatal);
+    omap5430_dss_map(SYS_BUS_DEVICE(dss));
+    omap5430_init_cpus(machine, pic);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dss), 0, pic[113]); /* OMAP5 DMM SPI */
+
+    sdma = qdev_new(TYPE_OMAP5430_SDMA);
+    object_property_add_child(OBJECT(machine), "sdma", OBJECT(sdma));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(sdma), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(sdma), 0, OMAP5430_SDMA_BASE);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dss), 1, pic[25]); /* DISPC SPI */
+    for (i = 0; i < 4; i++) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(sdma), i, pic[OMAP5430_SDMA_SPI + i]);
+    }
+
+    for (i = 0; i < ARRAY_SIZE(omap5430_uart_base); i++) {
+        /* UART3 is the boot/interactive console on the BMW image. */
+        int chardev = i == 2 ? 0 : (int)i + 1;
+
+        serial_mm_init(sysmem, omap5430_uart_base[i], 2,
+                       pic[omap5430_uart_spi[i]], 3000000,
+                       serial_hd(chardev), DEVICE_LITTLE_ENDIAN);
+    }
+
+    omap5430_init_usb(pic);
+    omap5430_sgx_register_types();
+
+    /* Native PowerVR register/MMU model; firmware execution is still pending. */
+    DeviceState *sgx = qdev_new("omap5430-sgx");
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(sgx), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(sgx), 0, 0x56000000);
+}
+
+static void omap5430_machine_class_init(ObjectClass *oc, const void *data)
+{
+    static const char * const valid_cpu_types[] = {
+        ARM_CPU_TYPE_NAME("cortex-a15"),
+        NULL
+    };
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "TI OMAP5430 BMW NBTevo experimental machine";
+    mc->init = omap5430_init;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("cortex-a15");
+    mc->valid_cpu_types = valid_cpu_types;
+    mc->default_cpus = 2;
+    mc->min_cpus = 1;
+    mc->max_cpus = 2;
+    mc->default_ram_size = 2048 * MiB;
+    mc->default_ram_id = "omap5430.ram";
+    mc->ignore_memory_transaction_failures = true;
+    /* Machine options are parsed before ordinary user-created objects. */
+}
+
+static const TypeInfo omap5430_machine_type = {
+    .name = MACHINE_TYPE_NAME("omap5430"),
+    .parent = TYPE_MACHINE,
+    .class_init = omap5430_machine_class_init,
+    .interfaces = arm_machine_interfaces,
+};
+
+static void omap5430_machine_init_register_types(void)
+{
+    type_register_static(&omap5430_machine_type);
+}
+
+type_init(omap5430_machine_init_register_types)
